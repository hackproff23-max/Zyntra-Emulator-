<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <Preference
        android:icon="@drawable/ic_setting_theme"
        android:key="pref_outline_color"
        app:persistent="false"
        android:summary="@string/pref_outline_color_summary"
        android:title="@string/pref_outline_color_title" />
    <Preference
        android:icon="@drawable/ic_menu_letters"
        android:key="pref_text_color"
        app:persistent="false"
        android:summary="@string/pref_text_color_summary"
        android:title="@string/pref_text_color_title" />
    <Preference
        android:icon="@drawable/ic_menu_png"
        android:key="pref_background_import"
        app:persistent="false"
        android:summary="@string/pref_background_import_summary"
        android:title="@string/pref_background_import_title" />
    <Preference
        android:key="pref_background_remove"
        app:persistent="false"
        android:title="@string/pref_background_remove_title" />
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_setting_enable_action_bar"
        android:key="pref_actionbar_switch"
        android:summary="@string/pref_enable_actionbar_summary"
        android:title="@string/pref_enable_actionbar_title" />
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_setting_enable_statusbar"
        android:key="pref_statusbar_switch"
        android:summary="@string/pref_enable_actionbar_summary"
        android:title="@string/pref_enable_statusbar_title" />
    <Preference
        android:key="pref_default_settings"
        android:icon="@drawable/ic_setting_default"
        android:title="@string/profiles" />
    <Preference
        android:key="emulator_dir"
        android:icon="@drawable/ic_setting_folder"
        android:title="@string/pref_emulator_dir"
        tools:summary="/sdcard/J2ME-Loader" />
</androidx.preference.PreferenceScreen>
